{
  "name": "postbox",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, lightweight API client - an open-source alternative to Postman.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "postbox": "dist/cli.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^23.5.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "next start",
    "start:local": "node scripts/local-server.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "screenshots": "node scripts/screenshots.mjs",
    "build:sandbox": "node scripts/build-sandbox.mjs",
    "predev": "npm run build:sandbox",
    "pretest": "npm run build:sandbox",
    "pretypecheck": "npm run build:sandbox",
    "prelint": "npm run build:sandbox",
    "prebuild": "npm run build:sandbox"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@faker-js/faker": "^10.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "commander": "^15.0.0",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "^1.64.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
    "papaparse": "^5.7.0",
    "postman-code-generators": "2.1.1",
    "postman-collection": "5.3.1",
    "quickjs-emscripten": "^0.32.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.15.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tough-cookie": "^6.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "buffer": "6.0.3",
    "chai": "4.5.0",
    "chai-postman": "2.0.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "lodash": "4.18.1",
    "playwright-core": "1.56",
    "prettier": "^3.9.10",
    "string_decoder": "1.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
