{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postbox Desktop",
  "mainBinaryName": "postbox-desktop",
  "version": "../../package.json",
  "identifier": "io.github.nkskater.postbox",
  "build": { "frontendDist": "../splash" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "Postbox", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../windows/app.ico"],
    "publisher": "Postbox",
    "homepage": "https://github.com/nkskater/postbox",
    "resources": {
      "../payload/app/": "app/",
      "../payload/runtime/postbox-node.exe": "runtime/postbox-node.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "../../windows/app.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
