{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postbox Desktop",
  "mainBinaryName": "postbox-desktop",
  "version": "../../package.json",
  "identifier": "io.github.nkskater.postbox",
  "build": { "frontendDist": "../splash" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../windows/app.ico"],
    "publisher": "Postbox",
    "homepage": "https://github.com/nkskater/postbox",
    "resources": {
      "../payload/app/": "app/",
      "../payload/runtime/postbox-node.exe": "runtime/postbox-node.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "../../windows/app.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERERDNBOEU1NEU2ODFEM0UKUldRK0hXaE81YWpUM2M5VzB2M2N0Y3l3ZFE4bzQ5RE1mRnE2NmwzMW5IclowbHFtR3U2a3BGZTAK",
      "endpoints": ["https://github.com/nkskater/postbox/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
