# Copy to .env (git-ignored) and fill in:   cp .env.example .env && chmod 600 .env
# docker compose reads .env automatically.

# --- Authentication (recommended) -------------------------------------------
# Password for the web login page.
POSTBOX_PASSWORD=
# Bearer token for MCP clients and scripts. Generate with: openssl rand -hex 32
POSTBOX_TOKEN=
# How long a login lasts, in days.
POSTBOX_SESSION_DAYS=30

# --- Network ------------------------------------------------------------------
# Host port to expose Postbox on.
POSTBOX_PORT=3000
# Comma-separated hosts/wildcards/CIDRs that requests may target (empty = all).
PROXY_ALLOW_HOSTS=
# Comma-separated hosts/wildcards/CIDRs that are always blocked, e.g. 169.254.169.254
PROXY_DENY_HOSTS=
# Extra browser origins allowed to call /api/mcp, e.g. https://webui.example.com
MCP_ALLOWED_ORIGINS=

# --- Script sandbox limits ----------------------------------------------------
SCRIPT_TIMEOUT_MS=5000
SCRIPT_MEMORY_MB=32
