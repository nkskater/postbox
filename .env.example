# Copy to .env (git-ignored) and fill in:   cp .env.example .env && chmod 600 .env
# docker compose reads .env automatically.

# --- Authentication (recommended) -------------------------------------------
# Password for the web login page.
POSTBOX_PASSWORD=
# Bearer token for MCP clients and scripts. Generate with: openssl rand -hex 32
POSTBOX_TOKEN=
# How long a login lasts, in days.
POSTBOX_SESSION_DAYS=30

# --- Network ------------------------------------------------------------------
# Host port to expose Postbox on.
POSTBOX_PORT=3000
# Comma-separated hosts/wildcards/CIDRs that requests may target (empty = all).
PROXY_ALLOW_HOSTS=
# Comma-separated hosts/wildcards/CIDRs that are always blocked, e.g. 169.254.169.254
PROXY_DENY_HOSTS=
# Extra browser origins allowed to call /api/mcp, e.g. https://webui.example.com
MCP_ALLOWED_ORIGINS=
# Largest JSON body accepted by the API and MCP endpoint, in MB (file uploads travel inline).
API_BODY_LIMIT_MB=25

# --- Script sandbox limits ----------------------------------------------------
# Leave empty to manage these under Settings → Request execution (defaults 5000 ms / 32 MB).
# A value pins the setting for everyone (clamped to 100-60000 ms and 8-512 MB).
SCRIPT_TIMEOUT_MS=
SCRIPT_MEMORY_MB=

# --- Container runtime limits -------------------------------------------------
# Total container memory (Docker byte value, e.g. 512m, 1g, 2g).
POSTBOX_MEMORY_LIMIT=1g
# CPU quota (fractional cores, e.g. 0.5, 1.0, 2.0).
POSTBOX_CPU_LIMIT=2.0
# Maximum container tasks (processes and threads).
POSTBOX_PIDS_LIMIT=256
